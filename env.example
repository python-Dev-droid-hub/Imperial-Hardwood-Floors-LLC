# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`.

# Public site origin (no trailing slash) — used for sitemap/canonical/OG
NEXT_PUBLIC_SITE_URL=https://imperial-hardwood-floors-llc-chi.vercel.app

# Gmail SMTP for the estimate form (Nodemailer)
GMAIL_USER=imperialhardwoodfloor@gmail.com
# 16-character Google App Password (not your normal Gmail password)
GMAIL_APP_PASSWORD=your-16-char-app-password
# Inbox that receives form submissions
MAIL_TO=imperialhardwoodfloor@gmail.com
